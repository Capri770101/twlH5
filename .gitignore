# 依赖
node_modules/

# 构建产物（沙箱多次构建产物目录，统一忽略）
dist/
dist-*/

# WorkBuddy 内部数据（迁移笔记等，非项目源码）
.workbuddy/

# 排查 .git 文件锁时产生的临时副本
.git_fresh/

# 系统/编辑器
.DS_Store
Thumbs.db
*.local
*.log

# 环境变量
.env
.env.*

# 微信支付商户证书（含私钥，切勿入库）
server/certs/

# 门店→子商户号真实映射（含商户号，模板见 server/config/submch.example.json）
server/config/submch.json

# 浏览器自动化残留（agent-browser skill 临时目录，非项目源码）
.playwright-mcp/

# 临时诊断脚本（依赖本地 .env 密钥，非项目运行所需，可本地保留但勿入库）
verify-*.mjs

# Python 字节码缓存（改 deploy/patches/*.py 后本地会生成）
__pycache__/
*.pyc

# 本地 UI 截图尚未完成敏感信息复核，不进入版本或发布包
docs/ui-preview/
