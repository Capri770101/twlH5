# 跳舞兰 H5 静态站点 + 智能体反代（twlh5-static.service）—— 环境变量样例
# 用法：复制为 /opt/twlh5-h5/.env 并填真实值；权限 600、属主 root。
#   cp deploy/env.static.example /opt/twlh5-h5/.env && chmod 600 /opt/twlh5-h5/.env
#   编辑后：sudo systemctl restart twlh5-static
#
# 由 systemd 的 EnvironmentFile=-/opt/twlh5-h5/.env 读取；同名会覆盖 unit 里的 Environment=。

# 智能体平台地址（支持 http/https；智能体将来单独部署到别的机器时只改这一行）
# 域名可用时填域名；域名停用时填智能体服务器 IP（例如 https://49.232.49.176）
AGENT_TARGET=https://49.232.49.176

# 🔐 智能体平台凭证（X-API-Key）
# 只存在于本服务，由反代注入到 /agent/* 的上游请求；
# 前端 bundle 不持有（打包后浏览器可见即等于公开）。
AGENT_API_KEY=
