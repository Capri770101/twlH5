# 跳舞兰 H5 业务后端 —— 环境变量样例
# 用法：复制为 /opt/twlh5-api/.env 并填入真实值；权限 600，切勿入库。
#   cp deploy/env.example /opt/twlh5-api/.env && chmod 600 /opt/twlh5-api/.env
#   编辑后：sudo systemctl restart twlh5-api

# ---------- 运行环境 ----------
NODE_ENV=production
API_PORT=4000

# ---------- 商品数据源（同事业务 API） ----------
# 这是**唯一启用**的商品读取通道。
# ⚠️ 旧「flower_shop 只读库」通道（db.js + DB_*）已弃用：只在 READ_SOURCE=mysql 时启用，
#    且其旧主机 118.25.21.45 已弃置。**不要再往本文件加 DB_* 段**。
READ_SOURCE=api
STORE_API_BASE=https://aistore.xiangbinmeigui.com
STORE_TIMEOUT=8000

# ---------- 业务库 h5_shop（订单/用户/支付/短信） ----------
H5_DB_HOST=127.0.0.1
H5_DB_PORT=3306
H5_DB_NAME=h5_shop
H5_DB_USER=h5_app
H5_DB_PASSWORD=
H5_DB_SSL=false

# ---------- 鉴权 ----------
# JWT 签名密钥（务必设置为随机长字符串；缺失时会退化派生，改库密码即导致全量 token 失效）
AUTH_SECRET=

# ---------- 短信验证码 ----------
# 生产环境务必保持 ALLOW_DEBUG_SMS 未设置或为 0：debug 模式含万能码，会绕过短信校验
ALLOW_DEBUG_SMS=0
# 通道：aliyun | tencent；留空则自动使用「已配齐」的那个
SMS_PROVIDER=

# —— 阿里云短信（dysmsapi）——
# AccessKey 建议用 RAM 子账号，只授予 AliyunDysmsFullAccess，不要用主账号 AK
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
# 变量名映射：**个数与键名必须与模板正文里的 ${xxx} 完全一致**（本项目模板只有一个 ${code}）
# 若模板正文形如「您的验证码是${code}，${min}分钟内有效」，则填 {"code":"{code}","min":"{ttl}"}
SMS_ALIYUN_TEMPLATE_PARAM={"code":"{code}"}
SMS_ALIYUN_REGION=cn-hangzhou

# —— 腾讯云短信（TC3）——
SMS_TC3_SECRET_ID=
SMS_TC3_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_TC3_REGION=ap-guangzhou

# ---------- 微信登录 ----------
# H5 公众号网页授权（服务号）
WX_OAUTH_APPID=
WX_OAUTH_SECRET=
WX_OAUTH_MODE=oa
# PC 扫码（微信开放平台网站应用，审核通过后填）
WX_OPEN_APPID=
WX_OPEN_SECRET=

# ---------- 微信支付（服务商 + 分账） ----------
WXPAY_SP_MCHID=
WXPAY_SP_APPID=
WXPAY_APIV3_KEY=
WXPAY_MERCHANT_SERIAL=
WXPAY_MERCHANT_KEY_PATH=./certs/apiclient_key.pem
WXPAY_NOTIFY_URL=https://h5.tiaowulan.com/api/pay/notify
WXPAY_H5_REDIRECT_URL=https://h5.tiaowulan.com/
# ---------- 分账（服务商把订单佣金分给服务商自身）----------
# 启用后：下单会带 settle_info.profit_sharing=true（仅佣金>0 的店铺），
# 且支付成功满 DELAY_HOURS 小时后由扫描任务发起分账。
# ⚠️ 关闭时不要手动标记分账：只标记不分账会让花店资金被冻结最长 30 天。
WXPAY_PROFITSHARING_ENABLED=true
WXPAY_PROFITSHARING_DELAY_HOURS=24
WXPAY_PROFITSHARING_SCAN_MS=600000
# 店铺未在 submch.json 配比例时的缺省比例（%）
WXPAY_PROFITSHARING_RATIO=10
# 分账运维接口令牌（/api/pay/ps/*）；留空则这些接口整体关闭
WXPAY_PS_ADMIN_TOKEN=

# ---------- 商家后端订单桥接（H5 → flower-shop） ----------
# 作用：H5 收款成功后把订单投递给同机的商家后端，从而自动获得
#       ① 企业微信群通知商家  ② 分派到门店（真实履约）  ③ 商家后台可见
# ⚠️ H5 仍保留自己的收款与退款（商家后端支付绑小程序 openid，无法交接）；
#    商家侧的自动分账必须保持关闭，否则同一笔订单会被分两次账。
# 总开关：false/留空 = 完全不投递（H5 订单行为与现状完全一致）
MERCHANT_BRIDGE_ENABLED=false
# 商家后端地址：测试端 3457（独立库，不惊动真实商家）/ 生产 3456
MERCHANT_BRIDGE_BASE=http://127.0.0.1:3457
# 相对资源（如 DIY 效果图 /agent/generated/xxx.png）转绝对 URL 用的基址
MERCHANT_BRIDGE_PUBLIC_BASE=https://h5.tiaowulan.com
# 结算金额与商家侧算出金额不一致时：warn=照常投递并告警 / block=拒绝投递
MERCHANT_BRIDGE_AMOUNT_GUARD=warn
# 服务间令牌（待小程序同事提供）。留空则退回「手机号登录」过渡方案
MERCHANT_BRIDGE_SERVICE_TOKEN=
# 过渡期登录用的验证码（商家后端当前仅此一条可拿到用户态 token 的路）
MERCHANT_BRIDGE_LOGIN_CODE=888888
# 单笔订单最多投递尝试次数（补偿扫描用）
MERCHANT_BRIDGE_MAX_ATTEMPTS=5
# 补偿扫描间隔（毫秒，最小 60000）
MERCHANT_BRIDGE_SCAN_MS=300000
# 请求超时（毫秒）
MERCHANT_BRIDGE_TIMEOUT_MS=10000
