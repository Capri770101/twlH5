# 跳舞兰 H5 业务后端 —— 环境变量样例
# 用法：复制为 /opt/twlh5-api/.env 并填入真实值；权限 600，切勿入库。
#   cp deploy/env.example /opt/twlh5-api/.env && chmod 600 /opt/twlh5-api/.env
#   编辑后：sudo systemctl restart twlh5-api

# ---------- 运行环境 ----------
NODE_ENV=production
API_PORT=4000

# ---------- 商品数据源（同事业务 API） ----------
READ_SOURCE=api
STORE_API_BASE=https://aistore.xiangbinmeigui.com
STORE_TIMEOUT=8000

# ---------- 业务库 h5_shop（订单/用户/支付/短信） ----------
H5_DB_HOST=127.0.0.1
H5_DB_PORT=3306
H5_DB_NAME=h5_shop
H5_DB_USER=h5_app
H5_DB_PASSWORD=
H5_DB_SSL=false

# ---------- 鉴权 ----------
# JWT 签名密钥（务必设置为随机长字符串；缺失时会退化派生，改库密码即导致全量 token 失效）
AUTH_SECRET=

# ---------- 短信（腾讯云） ----------
# 生产环境务必保持 ALLOW_DEBUG_SMS 未设置或为 0：debug 模式含万能码，会绕过短信校验
ALLOW_DEBUG_SMS=0
SMS_TC3_SECRET_ID=
SMS_TC3_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_TC3_REGION=ap-guangzhou

# ---------- 微信登录 ----------
# H5 公众号网页授权（服务号）
WX_OAUTH_APPID=
WX_OAUTH_SECRET=
WX_OAUTH_MODE=oa
# PC 扫码（微信开放平台网站应用，审核通过后填）
WX_OPEN_APPID=
WX_OPEN_SECRET=

# ---------- 微信支付（服务商 + 分账） ----------
WXPAY_SP_MCHID=
WXPAY_SP_APPID=
WXPAY_APIV3_KEY=
WXPAY_MERCHANT_SERIAL=
WXPAY_MERCHANT_KEY_PATH=./certs/apiclient_key.pem
WXPAY_NOTIFY_URL=https://h5.tiaowulan.com/api/pay/notify
WXPAY_H5_REDIRECT_URL=https://h5.tiaowulan.com/
# 是否主动发起分账（平台已配自动分账时保持 false）
WXPAY_TRIGGER_PROFITSHARING=false
